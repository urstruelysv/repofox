{
  "name": "repofox",
  "displayName": "RepoFox",
  "description": "AI-powered git workflow - branch to PR in one click",
  "version": "0.0.1",
  "publisher": "repofox",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/urstruelysv/repofox",
  "bugs": {
    "url": "https://github.com/urstruelysv/repofox/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/urstruelysv/repofox.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "ai",
    "commit",
    "pull request",
    "workflow",
    "automation"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repofox",
          "title": "RepoFox",
          "icon": "assets/icon-mono.svg"
        }
      ]
    },
    "views": {
      "repofox": [
        {
          "type": "webview",
          "id": "repofox.sidebar",
          "name": "RepoFox"
        }
      ]
    },
    "commands": [
      {
        "command": "repofox.runWorkflow",
        "title": "RepoFox: Branch -> PR"
      },
      {
        "command": "repofox.openSettings",
        "title": "RepoFox: Open Settings"
      },
      {
        "command": "repofox.runDiagnostics",
        "title": "RepoFox: Run Diagnostics"
      }
    ],
    "configuration": {
      "title": "RepoFox",
      "properties": {
        "repofox.aiProvider": {
          "type": "string",
          "enum": [
            "groq",
            "openai",
            "anthropic"
          ],
          "default": "groq",
          "description": "AI provider for generating branch names and commit messages"
        }
      }
    }
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "pnpm --dir ../../packages/ui build && pnpm build"
  },
  "dependencies": {
    "@repofox/core": "workspace:*",
    "@repofox/ui": "workspace:*"
  },
  "devDependencies": {
    "@repofox/config": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.26.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.0"
  }
}
