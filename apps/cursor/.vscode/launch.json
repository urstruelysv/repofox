{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch RepoFox (Cursor Extension Dev Host)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build:dev",
      "sourceMaps": true
    }
  ]
}
